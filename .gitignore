# icp-cli — ignore only the ephemeral build cache; **/.icp/data/ is committed
# (it holds the canister ID mappings)
**/.icp/cache/

# Motoko / mops
.mops/
mops.lock

# Rust
target/
Cargo.lock

# Node.js / frontends
node_modules/
package-lock.json
dist/
build/

# Generated canister bindings and Candid artifacts
**/src/bindings/
**/src/declarations/
*.old.did

# Local environment
.env

# IDEs and editors
.vscode/
.idea/

# OS
.DS_Store

# ICP skills — auto-synced into .claude/skills/ by the SessionStart hook
# (.claude/sync-ic-skills.sh); the hook + script are committed, the skills are not.
.claude/skills/
# Local Claude Code settings (personal; the shared hook lives in .claude/settings.json)
.claude/settings.local.json
